# BASTUS configuration — copy to .env.local and fill in.
# Phase 1 (offline mock engine) needs NONE of these; they are for live runs.

# Target model+harness under test (single stable key, unlimited calls)
TARGET_ENDPOINT=https://your-target/v1
TARGET_API_KEY=replace_me
TARGET_MODEL=target-model-name

# Attacker model (abliterated Qwen served via vLLM on RunPod, OpenAI-compatible)
ATTACKER_ENDPOINT=http://localhost:8000/v1
ATTACKER_API_KEY=EMPTY
ATTACKER_MODEL=qwen-abliterated

# Judge model (capable instruct model; vision-capable for multimodal)
JUDGE_ENDPOINT=https://your-judge/v1
JUDGE_API_KEY=replace_me
JUDGE_MODEL=gpt-4o

# Infrastructure
RUNPOD_API_KEY=
HF_TOKEN=
